{
  "expo": {
    "name": "SEC Insider Tracker",
    "slug": "sec-insider-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.secinsidertracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.yourname.secinsidertracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sectracker",
    "plugins": [
      "expo-font"
    ]
  }
}
